# Dependencies
node_modules/

# Next.js build output
.next/
Frontend/.next/

# Property/file images and uploads (served from disk, not meant for git)
Backend/uploads/
# Documentos privados de propiedades (escrituras, autorizaciones): fuera de /uploads público
Backend/private/

# Env files (contienen credenciales reales: TOKKO_TOKEN, SMTP_PASS, etc.)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
*.log

# Fotos de /_next/image ya generadas: se conservan entre deploys (Frontend/scripts/persistent-image-cache.mjs)
Frontend/.image-cache/

# Builds sin downtime (NEXT_DIST_DIR) y backups del build anterior
.next-*/
Frontend/.next-*/
